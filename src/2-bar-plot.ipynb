import matplotlib.pyplot as plt

# Data
categories = ['A', 'B', 'C', 'D']
values = [5, 7, 3, 9]
colors = ['red', 'blue', 'green', 'purple']

# Create bar plot
plt.bar(categories, values, color=colors)
plt.title('Bar Plot with Colors')
plt.xlabel('Categories')
plt.ylabel('Values')

# Show plot
plt.show()
